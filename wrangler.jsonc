{
  // Configuração do Cloudflare: publica o site estático gerado em dist/
  "name": "radardascamaras",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  },
  // Domínio próprio (o Cloudflare cria o DNS e o certificado HTTPS automaticamente)
  "routes": [
    { "pattern": "radardascamaras.com.br", "custom_domain": true },
    { "pattern": "www.radardascamaras.com.br", "custom_domain": true }
  ]
}
